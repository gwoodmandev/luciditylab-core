<!DOCTYPE html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
        <meta name="referrer" content="origin-when-cross-origin" />
        <meta name="robots" content="noindex">
        <meta name="theme-color" content="#ffffff">

        {% include "head/metadata.twig" %}

        <link rel="stylesheet" href="/assets/css/themes/default/main.css">
    </head>
    <body>
        {% include "structure/header.twig" %}
        <main id="main">
        
            {# Main content #}
            {# Loop through each module and output its content here #}
            <h1>Modules Here</h1>
            {% include "modules/copy-only.twig" with { module: {
                title: "Sample Module Title",
                body: "<p>This is some sample body content for the module.</p>"
            } } %}
            {# End main content #}

        </main>
        {% include "structure/footer.twig" %}
    </body>
    <script src="/assets/js/main.js" type="text/javascript"></script>
</html>
