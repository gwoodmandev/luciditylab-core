{% set logo = header.headerLogo.one() %}
{% set navItems = header.headerNavigation.all() %}
{% set ctas = header.headerCtas.all() %}

<header class="header" data-header>
    <div class="column">

        {% if logo %}
            <div class="header__logo">
                <a class="header__logo-link" href="{{ siteUrl }}" rel="home">
                    <img
                        src="{{ logo.url }}"
                        alt="{{ logo.alt ?: siteName }}"
                        {% if logo.width and logo.height %}
                            width="{{ logo.width }}"
                            height="{{ logo.height }}"
                        {% endif %}
                    />
                </a>
            </div>
        {% endif %}

        {% if navItems|length %}
            <div class="header__nav">
                {% include "partials/menus/nav" with {navItems: navItems} %}
            </div>
        {% endif %}


        {% if ctas|length %}
            <div class="header__ctas">
                {% for cta in ctas %}
                    {% set ctaLink = cta.link ?? null %}
                    {% if ctaLink %}
                        <a class="btn btn--{{ cta.ctaStyle }}" href="{{ ctaLink.url }}" {% if cta.linkNewWindow %}target="_blank" rel="noopener"{% endif %}>{{ cta.linkLabel ?: ctaLink.label }}</a>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

    </div>
</header>
