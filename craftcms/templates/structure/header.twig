{% set logo = header.headerLogo.one() %}
{% set navItems = header.headerNavigation.all() %}
{% set ctaItems = header.headerCtas.all() %}

<header class="header" data-header>
    <div class="column">

        {% if logo %}
            <div class="header__logo">
                <a class="header__logo-link" href="{{ siteUrl }}" rel="home">
                    <img
                        src="{{ logo.url }}"
                        alt="{{ logo.alt ?: siteName }}"
                        {% if logo.width and logo.height %}
                            width="{{ logo.width }}"
                            height="{{ logo.height }}"
                        {% endif %}
                    />
                </a>
            </div>
        {% endif %}

        <div class="header__nav">
            {% include "partials/menus/nav" with {navItems: navItems, ctaItems: ctaItems} %}
        </div>
    </div>
</header>
