<!DOCTYPE html>
<html lang="en-GB">
    <head>
        {% include "head/metadata" %}
        {% include "head/links" %}
        {% block headExtra %}{% endblock %}
    </head>
    <body{% block bodyClass %}{% endblock %}>
        {% include "structure/header" %}
        <main id="main"{% block mainClass %}{% endblock %}>
            {# Templates override this block with their content #}
            {% block content %}{% endblock %}
        </main>
        {% include "structure/footer" %}        
        {% block scriptsExtra %}{% endblock %}
        <script src="/assets/js/main.js" type="text/javascript"></script>
    </body>
</html>