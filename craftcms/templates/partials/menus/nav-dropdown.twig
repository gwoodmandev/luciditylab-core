{% if navSubLinks|length %}
    <button class="nav__sub-trigger u-hidden-desktop" aria-expanded="false" aria-controls="{{ dropdownId }}" aria-label="Open navigation sub menu" data-nav-trigger>
        <svg width="24" height="24">
            <use href="/assets/icons/sprite.svg#icon-arrow-right" />
        </svg>
    </button>
    <div id="{{ dropdownId }}" class="nav__dropdown" data-nav-dropdown>
        <ul class="nav__sub-menu" data-nav-dropdown-wrapper>
            {% for navSub in navSubLinks %}
                {% set subLink = navSub.link ?? null %}
                {% if subLink %}
                    <li class="nav__item">
                        <a class="nav__item-link" href="{{ subLink.url }}" {% if navSub.linkNewWindow %}target="_blank" rel="noopener"{% endif %}>{{ navSub.linkLabel ?: subLink.label }}</a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
{% endif %}