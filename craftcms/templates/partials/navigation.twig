{% if header.navigation|length %}
    <nav id="nav" class="nav" aria-hidden="true">
        <div class="nav__inner" data-nav>
            <div class="nav__wrapper" data-nav-wrapper>
                <ul class="nav__list">
                    {% for navigationItem in header.navigation %}
                        <li class="nav-item">
                            <a href="{{ navigationItem.itemLink.value }}" class="nav-item__link">
                                <span class="nav-item__label">{{ navigationItem.title }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                <ul class="nav__links">
                    <li class="nav-link nav-link--heading">Useful Links</li>
                    <li class="nav-link">
                        <a href="/" class="nav-link__link">
                            <span class="nav-link__label">Instagram</span>
                        </a>
                    </li>
                    <li class="nav-link">
                        <a href="/" class="nav-link__link">
                            <span class="nav-link__label">LinkedIn</span>
                        </a>
                    </li>
                    <li class="nav-link">
                        <a href="/" class="nav-link__link">
                            <span class="nav-link__label">Terms of Use</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <button class="nav-trigger" aria-expanded="false" aria-controls="nav" aria-label="Open navigation nenu" data-nav-trigger>
        {% include "svgs/menu-icon" %}
    </button>
{% endif %}