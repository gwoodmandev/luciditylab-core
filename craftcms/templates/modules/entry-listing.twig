{% set columnCount = block.columnCount ?? '3' %}
{% set displayStyle = block.displayStyle ?? 'cards' %}
{% set entryLimit = block.entryLimit ?? 6 %}

{% set query = craft.entries()
    .section(block.relatedSection)
    .limit(entryLimit) %}

{% if block.categoryFilter | length %}
    {% set query = query.relatedTo(block.categoryFilter.one()) %}
{% endif %}

{% set entries = query.all() %}

<section class="entry-listing module entry-listing--cols-{{ columnCount }} entry-listing--{{ displayStyle }}{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}{% if block.paddingSize %} module--padding-{{ block.paddingSize }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.subheading %}
            <div class="entry-listing__header module__text">
                {% if block.heading %}
                    <h2 class="module__heading u-h2">{{ block.heading }}</h2>
                {% endif %}
                {% if block.subheading %}
                    <p class="module__subheading u-h4">{{ block.subheading }}</p>
                {% endif %}
            </div>
        {% endif %}

        {% if entries | length %}
            <div class="entry-listing__grid">
                {% for entry in entries %}
                    {% include "components/card" with { card: entry, style: displayStyle } %}
                {% endfor %}
            </div>
        {% else %}
            <p class="entry-listing__empty">No entries found.</p>
        {% endif %}

    </div>
</section>
