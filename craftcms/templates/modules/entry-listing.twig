{# Set class variables #}
{% set classColumns = 'entry-listing--cols-' ~ (block.columnCount ?? '3') %}
{% set classDisplay = 'entry-listing--display-' ~ (block.displayStyle ?? 'cards') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classColumns} #{classDisplay} #{classBackground} #{classPadding}" %}

{# Do entry filtering #}
{% set entryLimit = block.entryLimit ?? 6 %}
{% set query = craft.entries()
    .section(block.relatedSection)
    .limit(entryLimit) %}
{% if block.categoryFilter | length %}
    {% set query = query.relatedTo(block.categoryFilter.one()) %}
{% endif %}
{% set entries = query.all() %}

<section class="entry-listing module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.subheading %}
            <div class="entry-listing__header module__text">
                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {{ headingTag(block.subheading, 'module__subheading u-h4') }}
            </div>
        {% endif %}

        {% if entries|length %}
            <div class="entry-listing__grid">
                {% for entry in entries %}
                    {% include "components/card" with { card: entry, style: displayStyle } %}
                {% endfor %}
            </div>
        {% else %}
            <p class="entry-listing__empty">No entries found.</p>
        {% endif %}

    </div>
</section>
