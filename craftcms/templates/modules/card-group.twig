{# Set class variables #}
{% set classColumns = 'card-group--cols-' ~ (block.columnCount ?? '3') %}
{% set classDisplay = 'card-group--display-' ~ (block.displayStyle ?? 'cards') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classColumns} #{classDisplay} #{classBackground} #{classPadding}" %}

<section class="card-group module {{ classList }}" {% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">
        {% if block.heading or block.subheading %}
            <div class="card-group__header module__text">
                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {{ headingTag(block.subheading, 'module__subheading u-h4') }}
            </div>
        {% endif %}
        {% if block.relatedEntries|length %}
            <div class="card-group__grid">
                {% for entry in block.relatedEntries.all() %}
                    {% include "components/card" with { card: entry, style: block.displayStyle } %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
