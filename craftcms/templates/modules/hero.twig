{% set layoutVariant = block.layoutVariant ?? 'standard' %}
{% set hasMedia = block.image.one() or block.videoUrl or block.nativeVideo.one() %}

<section class="hero module hero--{{ layoutVariant }}{% if block.textAlignment %} hero--align-{{ block.textAlignment }}{% endif %}{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>

    {% if hasMedia %}
        <div class="hero__media module__fullwidth">

            {% if block.image.one() %}
                {% import 'macros/picture' as picture %}
                {{ picture.custom(block.image.one(),
                    breakpoints: "0,768",
                    sizes: "768x600,1920x1080",
                    alt: block.altText ?? '',
                    loading: "eager",
                    fetchpriority: "high",
                    attributes: ["data-speed=\"0.9\""]
                ) }}
            {% elseif block.videoUrl %}
                {% import 'macros/video' as video %}
                {{ video.custom(
                    url: block.videoUrl,
                    ratio: '16x9',
                    loading: 'eager'
                ) }}
            {% elseif block.nativeVideo.one() %}
                {% import 'macros/video' as video %}
                {{ video.custom(
                    asset: block.nativeVideo.one(),
                    ratio: 'auto',
                    autoplay: true,
                    muted: true,
                    loop: true,
                    controls: false,
                    attributes: ["data-speed=\"0.9\""]
                ) }}
            {% endif %}

            {% if block.overlayOpacity %}
                <div class="hero__overlay hero__overlay--{{ block.overlayOpacity }}"></div>
            {% endif %}

        </div>
    {% endif %}

    <div class="column">
        <div class="hero__content module__text">

            {% if block.heading %}
                <h1 class="module__heading u-h1">{{ block.heading }}</h1>
            {% endif %}

            {% if block.subheading %}
                <p class="module__subheading u-h3">{{ block.subheading }}</p>
            {% endif %}

            {% if block.introText %}
                <p class="hero__intro module__intro">{{ block.introText }}</p>
            {% endif %}

            {% if block.buttons | length %}
                {% include "components/buttons" with { buttons: block.buttons } %}
            {% endif %}

        </div>
    </div>

</section>
