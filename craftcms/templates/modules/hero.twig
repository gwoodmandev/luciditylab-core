{# Set module defaults #}
{% set layoutVariant = block.layoutVariant ?? 'standard' %}
{% set textAlignment = block.textAlignment ?? 'left' %}
{% set backgroundColour = block.backgroundColour ?? 'none' %}
{% set hasMedia = block.image.one() or block.videoUrl or block.nativeVideo.one() %}

{# Set class variables #}
{% set classLayout = 'module--layout-' ~ layoutVariant %}
{% set classAlignment = 'module--align-' ~ textAlignment %}
{% set classBackground = 'module--bg-' ~ backgroundColour %}

<section class="hero module {{ classLayout }} {{ classAlignment }} {{ classBackground }}" {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>

    {% if hasMedia %}
        <div class="hero__media module__fullwidth">

            {% if block.image.one() %}
                {% import 'macros/picture' as picture %}
                {{ picture.custom(block.image.one(),
                    breakpoints: "0,768",
                    sizes: "768x600,1920x1080",
                    alt: block.altText ?? '',
                    loading: "eager",
                    fetchpriority: "high",
                    attributes: ["data-speed=\"0.9\""]
                ) }}
            {% elseif block.videoUrl %}
                {% import 'macros/video' as video %}
                {{ video.custom(
                    url: block.videoUrl,
                    ratio: '16x9',
                    loading: 'eager'
                ) }}
            {% elseif block.nativeVideo.one() %}
                {% import 'macros/video' as video %}
                {{ video.custom(
                    asset: block.nativeVideo.one(),
                    ratio: 'auto',
                    autoplay: true,
                    muted: true,
                    loop: true,
                    controls: false,
                    attributes: ["data-speed=\"0.9\""]
                ) }}
            {% endif %}

            {% if block.overlayOpacity %}
                <div class="hero__overlay hero__overlay--{{ block.overlayOpacity }}"></div>
            {% endif %}

        </div>
    {% endif %}

    <div class="column">
        <div class="hero__content module__text">

            {{ headingTag(block.heading, 'module__heading u-h1') }}
            {{ headingTag(block.subheading, 'module__subheading u-h3') }}

            {% if block.introText %}
                <p class="hero__intro module__intro">{{ block.introText }}</p>
            {% endif %}

            {% if block.buttons | length %}
                {% include "components/buttons" with { buttons: block.buttons } %}
            {% endif %}

        </div>
    </div>

</section>
