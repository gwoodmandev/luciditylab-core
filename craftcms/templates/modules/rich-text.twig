<section class="rich-text module{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}{% if block.paddingSize %} module--padding-{{ block.paddingSize }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>
    <div class="column">
        <div class="rich-text__content module__text module__text--{{ block.textWidth ?? 'normal' }}">

            {% if block.bodyText %}
                <div class="rich-text__copy module__copy">
                    {{ block.bodyText|raw }}
                </div>
            {% endif %}

        </div>
    </div>
</section>
