{% set layoutVariant = block.layoutVariant ?? 'contained' %}
{% set hasMedia = block.image.one() or block.videoUrl or block.nativeVideo.one() %}

<section class="media module media--{{ layoutVariant }}{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}{% if block.paddingSize %} module--padding-{{ block.paddingSize }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>
    <div class="{% if layoutVariant == 'full-width' %}media__fullwidth{% else %}column{% endif %}">

        {% if hasMedia %}
            <figure class="media__figure">

                {% if block.image.one() %}
                    {% import 'macros/picture' as picture %}
                    {{ picture.custom(block.image.one(),
                        breakpoints: "0,768",
                        sizes: "768x500,1920x800",
                        alt: block.altText ?? '',
                        loading: "lazy",
                        fetchpriority: "auto",
                        attributes: []
                    ) }}
                {% elseif block.videoUrl %}
                    {% import 'macros/video' as video %}
                    {{ video.custom(
                        url: block.videoUrl,
                        ratio: '16x9',
                        loading: 'lazy'
                    ) }}
                {% elseif block.nativeVideo.one() %}
                    {% import 'macros/video' as video %}
                    {{ video.custom(
                        asset: block.nativeVideo.one(),
                        poster: block.image.one() ?? null,
                        ratio: '16x9',
                        controls: true
                    ) }}
                {% endif %}

                {% if block.caption %}
                    <figcaption class="media__caption module__caption">{{ block.caption }}</figcaption>
                {% endif %}

            </figure>
        {% endif %}

    </div>
</section>
