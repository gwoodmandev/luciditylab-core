{% set textAlignment = "module-align--" ~ block.textAlignment %}

<section class="copy-only module {{ textAlignment }}">
    <div class="column">
        <div class="copy-only__content module__text">

            {% if block.heading %}
                <h2>{{ block.heading }}</h2>
            {% endif %}
            
            {% if block.content %}
                <div class="copy-only__text">
                    {{ block.content|raw }}
                </div>
            {% endif %}

            {% if block.buttons %}
                {% include "components/buttons" with { buttons: block.buttons } %}
            {% endif %}

        </div>
    </div>
</section>