<div class="spacer module spacer--{{ block.spacerSize ?? 'medium' }}{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>
    {% if block.showDivider %}
        <div class="column">
            <hr class="spacer__divider" aria-hidden="true">
        </div>
    {% endif %}
</div>
