{# Set class variables #}
{% set classSpacer = 'spacer--' ~ (block.spacerSize ?? 'medium') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classList = "#{classSpacer} #{classBackground}" %}

<div class="spacer module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    {% if block.showDivider %}
        <div class="column">
            <hr class="spacer__divider" aria-hidden="true">
        </div>
    {% endif %}
</div>
