{% set mediaWidth = "module-width--" ~ block.mediaWidth %}
{% set mediaPosition = block.mediaPosition ? "module-position--right" : "module-position--left" %}
{% set mediaSizes = block.mediaWidth == "66" ? "768x860,838x660" : "768x860,616x460" %}

<section class="copy-media module {{ mediaWidth }} {{ mediaPosition }}">
    <div class="column">

        {% if block.image %}
            {% import 'macros/picture' as picture %}
            <div class="copy-media__media">
                <div class="copy-media__media-wrapper">
                    {{ picture.custom(block.image.one(), 
                        breakpoints: "0,768",
                        sizes: mediaSizes,
                        alt: "Alt text here",
                        loading: "lazy",
                        attributes: ["data-speed=\"0.9\""]
                    ) }}
                </div>
            </div>
        {% endif %}

        <div class="copy-media__content module__text">

            {% if block.heading %}
                <h2 class="module__heading u-h2">{{ block.heading }}</h2>
            {% endif %}
            
            {% if block.content %}
                <div class="copy-only__text module__copy">
                    {{ block.content|raw }}
                </div>
            {% endif %}

            {% include "components/buttons" with { buttons: block.buttons } %}

        </div>
    </div>
</section>