{# Set class variables #}
{% set classAlignment = 'module--align-' ~ (block.textAlignment ?? 'centre') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classAlignment} #{classBackground} #{classPadding}" %}

<section class="cta {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">
        <div class="cta__content module__text">

            {{ headingTag(block.heading, 'module__heading u-h1') }}
            {{ headingTag(block.subheading, 'module__subheading u-h4') }}

            {% if block.introText %}
                <p class="cta__intro module__intro">{{ block.introText }}</p>
            {% endif %}

            {% include "components/buttons" with { buttons: block.buttons } %}

        </div>
    </div>
</section>
