{#
    Form block - renders a Freeform or Formie form selected by the editor.
    To switch to Formie, replace the render line with:
    {{ craft.formie.renderForm(block.form.one().handle) }}
#}

<section class="form module{% if block.textAlignment %} form--align-{{ block.textAlignment }}{% endif %}{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}{% if block.paddingSize %} module--padding-{{ block.paddingSize }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.introText %}
            <div class="form__header module__text">
                {% if block.heading %}
                    <h2 class="module__heading u-h2">{{ block.heading }}</h2>
                {% endif %}
                {% if block.introText %}
                    <p class="form__intro module__intro">{{ block.introText }}</p>
                {% endif %}
            </div>
        {% endif %}

        {% if block.form | length %}
            <div class="form__body">
                {{ craft.freeform.form(block.form.one().handle).render() }}
            </div>
        {% endif %}

    </div>
</section>
