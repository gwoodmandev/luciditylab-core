{#
    Form block - renders a Freeform or Formie form selected by the editor.
    To switch to Formie, replace the render line with:
    {{ craft.formie.renderForm(block.form.one().handle) }}
#}

{# Set class variables #}
{% set classAlignment = 'module--align-' ~ (block.textAlignment ?? 'left') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classAlignment} #{classBackground} #{classPadding}" %}

<section class="form module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.introText %}
            <div class="form__header module__text">
                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {% if block.introText %}
                    <p class="form__intro module__intro">{{ block.introText }}</p>
                {% endif %}
            </div>
        {% endif %}

        {# {% if block.form|length %}
            <div class="form__body">
                {{ craft.freeform.form(block.form.one().handle).render() }}
            </div>
        {% endif %} #}

    </div>
</section>
