{# Register assets #}
{% do registerStylesheet('module', 'form') %}

{# Set class variables #}
{% set classAlignment = 'module--align-' ~ (block.textAlignment ?? 'left') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classAlignment} #{classBackground} #{classPadding}" %}

{% set formEntry = block.form.one() %}

<section class="contact-form module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.introText %}
            <div class="contact-form__header module__text">
                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {% if block.introText %}
                    <p class="contact-form__intro module__intro">{{ block.introText }}</p>
                {% endif %}
            </div>
        {% endif %}

        {% if formEntry %}
            <div class="contact-form__body">
                {% if formEntry.bodyText %}
                    <div class="contact-form__copy module__copy">{{ formEntry.bodyText|raw }}</div>
                {% endif %}

                {{ craft.formBuilder.render(formEntry) }}
            </div>
        {% endif %}

    </div>
</section>
