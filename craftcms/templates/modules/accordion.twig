{# Set class variables #}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classBackground} #{classPadding}" %}

{# Open first accordion #}
{% set openFirst = block.openFirstItem ?? false %}

<section class="accordion module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.subheading %}
            <div class="accordion__header module__text">
                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {{ headingTag(block.subheading, 'module__subheading u-h3') }}
            </div>
        {% endif %}

        {# {% if block.accordionItems|length %}
            <div class="accordion__items">
                {% for item in block.accordionItems.all() %}
                    {% set isOpen = openFirst and loop.first %}
                    <div class="accordion__item{% if isOpen %} is-open{% endif %}">
                        <button class="accordion__trigger" aria-expanded="{{ isOpen ? 'true' : 'false' }}" aria-controls="accordion-panel-{{ item.id }}">
                            <span>{{ item.heading }}</span>
                            <span class="accordion__icon" aria-hidden="true"></span>
                        </button>
                        <div class="accordion__panel" id="accordion-panel-{{ item.id }}" {% if not isOpen %}hidden{% endif %}>
                            <div class="accordion__panel-inner module__copy">
                                {{ item.bodyText|raw }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %} #}

    </div>
</section>
