{# Register assets #}
{% do registerStylesheet('module', 'accordion') %}
{% do registerScript('module', 'accordion') %}

{# Set class variables #}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classBackground} #{classPadding}" %}

{# Open first accordion #}
{% set openFirst = block.openFirstItem ?? false %}

<section class="accordion module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.subheading %}
            <div class="accordion__header module__text">
                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {{ headingTag(block.subheading, 'module__subheading u-h3') }}
            </div>
        {% endif %}

        {% set items = block.accordionItems.all() %}

        {% if items|length %}
            <div class="accordion__items" data-accordion>
                {% for item in items %}
                    {% set isOpen = openFirst and loop.first %}
                    <div class="accordion__item" data-accordion-item{% if isOpen %} data-accordion-open{% endif %}>
                        <button
                            type="button"
                            class="accordion__trigger"
                            aria-expanded="{{ isOpen ? 'true' : 'false' }}"
                            aria-controls="accordion-panel-{{ item.id }}"
                            data-accordion-trigger
                        >
                            <span>{{ item.heading.text ?? '' }}</span>
                            <span class="accordion__icon" aria-hidden="true"></span>
                        </button>
                        {# no [hidden] here: the panel must stay measurable so its
                           inner height can be written to a custom property #}
                        <div
                            class="accordion__panel"
                            id="accordion-panel-{{ item.id }}"
                            data-accordion-panel
                            {% if not isOpen %}inert{% endif %}
                        >
                            <div class="accordion__panel-inner module__copy" data-accordion-inner>
                                {{ item.bodyText|raw }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
