{% import 'macros/picture' as picture %}

<section class="homepage-hero module">
    <div class="column">
        <div class="homepage-hero__content module__text">

            {% if block.heading %}
                <h2>{{ block.heading }}</h2>
            {% endif %}
            
            {% if block.content %}
                <div class="homepage-hero__text">
                    {{ block.content|raw }}
                </div>
            {% endif %}

            {% if block.buttons %}
                {% include "components/buttons" with { buttons: block.buttons } %}
            {% endif %}

        </div>

        {% if block.image %}
            <div class="homepage-hero__image module__fullwidth">
                {{ picture.custom(block.image.one(), 
                    breakpoints: "0,768",
                    sizes: "768x432,1920x1080",
                    alt: "Alt text here",
                    loading: "lazy",
                    fetchpriority: "low"
                ) }}
            </div>
        {% endif %}
    </div>
</section>