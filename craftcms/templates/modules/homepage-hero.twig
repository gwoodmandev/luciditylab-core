<section class="homepage-hero module">
    <div class="column">
        <div class="homepage-hero__content module__text">

            {% if block.heading %}
                <h1 class="module__heading u-h1">{{ block.heading }}</h1>
            {% endif %}

            {# {% if block.subheading %}
                <h2 class="module__subheading u-sub">{{ block.subheading }}</h2>
            {% endif %} #}

        </div>

        {% if block.image %}
            {% import 'macros/picture' as picture %}
            <div class="homepage-hero__image module__fullwidth">
                {{ picture.custom(block.image.one(), 
                    breakpoints: "0,768",
                    sizes: "768x768,1920x1080",
                    alt: "Alt text here",
                    loading: "eager",
                    fetchpriority: "high",
                    attributes: ["data-speed=\"0.9\""]
                ) }}
            </div>
        {% endif %}

    </div>
</section>