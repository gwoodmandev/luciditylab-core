{% set mediaPosition = block.mediaPosition ?? 'left' %}
{% set mediaRatio = block.mediaRatio ?? '50-50' %}
{% set hasMedia = block.image.one() or block.videoUrl or block.nativeVideo.one() %}

<section class="content-block module content-block--media-{{ mediaPosition }} content-block--ratio-{{ mediaRatio|replace({':', '-'}) }}{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}{% if block.paddingSize %} module--padding-{{ block.paddingSize }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>
    <div class="column">
        <div class="content-block__inner">

            <div class="content-block__content module__text">

                {% if block.heading %}
                    <h2 class="module__heading u-h2">{{ block.heading }}</h2>
                {% endif %}

                {% if block.subheading %}
                    <p class="module__subheading u-h4">{{ block.subheading }}</p>
                {% endif %}

                {% if block.introText %}
                    <p class="content-block__intro module__intro">{{ block.introText }}</p>
                {% endif %}

                {% if block.bodyText %}
                    <div class="content-block__copy module__copy">
                        {{ block.bodyText|raw }}
                    </div>
                {% endif %}

                {% if block.buttons | length %}
                    {% include "components/buttons" with { buttons: block.buttons } %}
                {% endif %}

            </div>

            {% if hasMedia %}
                <div class="content-block__media module__media">

                    {% if block.image.one() %}
                        {% import 'macros/picture' as picture %}
                        {{ picture.custom(block.image.one(),
                            breakpoints: "0,768",
                            sizes: "768x600,1280x960",
                            alt: block.altText ?? '',
                            loading: "lazy",
                            fetchpriority: "auto",
                            attributes: []
                        ) }}
                    {% elseif block.videoUrl %}
                        {% import 'macros/video' as video %}
                        {{ video.custom(
                            url: block.videoUrl,
                            ratio: '16x9',
                            loading: 'lazy'
                        ) }}
                    {% elseif block.nativeVideo.one() %}
                        {% import 'macros/video' as video %}
                        {{ video.custom(
                            asset: block.nativeVideo.one(),
                            poster: block.image.one() ?? null,
                            ratio: '16x9',
                            controls: true
                        ) }}
                    {% endif %}

                    {% if block.caption %}
                        <p class="content-block__caption module__caption">{{ block.caption }}</p>
                    {% endif %}

                </div>
            {% endif %}

        </div>
    </div>
</section>
