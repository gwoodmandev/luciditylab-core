{# Set module defaults #}
{% set hasMedia = block.image.one() or block.videoUrl or block.nativeVideo.one() %}

{# Set class variables #}
{% set classMediaPosition = 'content-block--media-' ~ (block.mediaPosition ?? 'left') %}
{% set classMediaRatio = 'content-block--ratio-' ~ (block.mediaRatio ?? '50-50')|replace(':', '-') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classMediaPosition} #{classMediaRatio} #{classBackground} #{classPadding}" %}

<section class="content-block module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">
        <div class="content-block__inner">
            <div class="content-block__content module__text">

                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {{ headingTag(block.subheading, 'module__subheading u-h3') }}

                {% if block.introText %}
                    <p class="content-block__intro module__intro">{{ block.introText }}</p>
                {% endif %}

                {% if block.bodyText %}
                    <div class="content-block__copy module__copy">
                        {{ block.bodyText|raw }}
                    </div>
                {% endif %}

                {% include "components/buttons" with { buttons: block.buttons } %}

            </div>

            {% if hasMedia %}
                <div class="content-block__media module__media">

                    {% if block.image.one() %}
                        {% import 'macros/picture' as picture %}
                        {{ picture.custom(block.image.one(),
                            breakpoints: "0,768",
                            sizes: "768x600,1280x960",
                            alt: block.altText ?? '',
                            loading: "lazy",
                            fetchpriority: "auto",
                            attributes: []
                        ) }}
                    {% elseif block.videoUrl %}
                        {% import 'macros/video' as video %}
                        {{ video.custom(
                            url: block.videoUrl,
                            ratio: '16x9',
                            loading: 'lazy'
                        ) }}
                    {% elseif block.nativeVideo.one() %}
                        {% import 'macros/video' as video %}
                        {{ video.custom(
                            asset: block.nativeVideo.one(),
                            poster: block.image.one() ?? null,
                            ratio: '16x9',
                            controls: true
                        ) }}
                    {% endif %}

                    {% if block.caption %}
                        <p class="content-block__caption module__caption">{{ block.caption }}</p>
                    {% endif %}

                </div>
            {% endif %}

        </div>
    </div>
</section>