{% set layoutVariant = block.layoutVariant ?? '16-9' %}
{% set textWidth = block.textWidth ?? 'normal' %}

<section class="embed module{% if block.backgroundColour %} module--bg-{{ block.backgroundColour }}{% endif %}{% if block.paddingSize %} module--padding-{{ block.paddingSize }}{% endif %}"
    {% if block.anchorId %}id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.introText %}
            <div class="embed__header module__text module__text--{{ textWidth }}">
                {% if block.heading %}
                    <h2 class="module__heading u-h2">{{ block.heading }}</h2>
                {% endif %}
                {% if block.introText %}
                    <p class="embed__intro module__intro">{{ block.introText }}</p>
                {% endif %}
            </div>
        {% endif %}

        {% if block.bodyText %}
            <div class="embed__code embed__code--ratio-{{ layoutVariant }}">
                {{ block.bodyText|raw }}
            </div>
        {% elseif block.videoUrl %}
            <div class="embed__wrapper embed__wrapper--ratio-{{ layoutVariant }}">
                {% include "components/video-embed" with { url: block.videoUrl } %}
            </div>
        {% endif %}

    </div>
</section>
