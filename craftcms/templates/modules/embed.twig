{# Set class variables #}
{% set classLayout = 'embed--layout-' ~ (block.layoutVariant ?? 'standard') %}
{% set classTextWidth = 'module__text--' ~ (block.textWidth ?? 'normal') %}
{% set classAlignment = 'module--align-' ~ (block.textAlignment ?? 'centre') %}
{% set classBackground = 'module--bg-' ~ (block.backgroundColour ?? 'none') %}
{% set classPadding = 'module--padding-' ~ (block.paddingSize ?? 'none') %}
{% set classList = "#{classLayout} #{classAlignment} #{classBackground} #{classPadding}" %}

<section class="embed module {{ classList }}"{% if block.anchorId %} id="{{ block.anchorId }}"{% endif %}>
    <div class="column">

        {% if block.heading or block.subheading or block.introText %}
            <div class="embed__header module__text {{ classTextWidth }}">
                {{ headingTag(block.heading, 'module__heading u-h1') }}
                {{ headingTag(block.subheading, 'module__subheading u-h3') }}

                {% if block.introText %}
                    <p class="embed__intro module__intro">{{ block.introText }}</p>
                {% endif %}
            </div>
        {% endif %}

        {# {% if block.bodyText %}
            <div class="embed__code embed__code--ratio-{{ layoutVariant }}">
                {{ block.bodyText|raw }}
            </div>
        {% elseif block.videoUrl %}
            <div class="embed__wrapper embed__wrapper--ratio-{{ layoutVariant }}">
                {% include "components/video-embed" with { url: block.videoUrl } %}
            </div>
        {% endif %} #}

    </div>
</section>
