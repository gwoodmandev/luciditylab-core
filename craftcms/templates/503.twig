<!DOCTYPE html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>We’ll be back shortly</title>

        <style>
            :root { color-scheme: light dark; }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                line-height: 1.5;
                color: #111;
                background: #fff;
                text-align: center;
            }

            @media (prefers-color-scheme: dark) {
                body { color: #f5f5f5; background: #111; }
            }

            h1 { font-size: clamp(1.5rem, 4vw, 2.25rem); margin: 0 0 0.5rem; }
            p { margin: 0; opacity: 0.75; }
        </style>
    </head>
    <body>
        <main>
            <h1>We’ll be back shortly</h1>
            <p>The site is temporarily offline for maintenance. Please try again in a few minutes.</p>
        </main>
    </body>
</html>
