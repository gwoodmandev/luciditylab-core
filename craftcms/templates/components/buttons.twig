{% if buttons|length %}
    {# Register assets #}
    {% do registerStylesheet('component', 'button') %}

    <div class="btn__container">
        {% for button in buttons %}
            {% if button.buttonUrl.value != "" %}
                {% set buttonLabel = button.buttonLabel ?? button.buttonUrl.label %}
                {% set buttonTarget = button.buttonUrl.target ?? "_self" %}

                <a class="btn btn--{{ button.buttonStyle }}" href="{{ button.buttonUrl }}" target="{{ buttonTarget }}">
                    <span class="btn__label">{{ buttonLabel }}</span>
                    <span class="btn__icon">
                        <svg width="24" height="24">
                            <use href="/assets/icons/sprite.svg#icon-arrow-right" />
                        </svg>
                    </span>
                </a>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}