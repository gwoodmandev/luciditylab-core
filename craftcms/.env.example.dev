# Environment
CRAFT_ENVIRONMENT=dev

# Security Key - Generate a random string
# You can generate one at: https://craftcms.com/docs/4.x/installation.html#step-3-set-a-security-key
CRAFT_SECURITY_KEY=

# App ID - Generate a random UUID
# You can use: https://www.uuidgenerator.net/
CRAFT_APP_ID=

# Database Configuration
DB_DRIVER=mysql
DB_SERVER=db
DB_PORT=3306
DB_DATABASE=craft
DB_USER=craft
DB_PASSWORD=craft
DB_SCHEMA=public
DB_TABLE_PREFIX=

# Site URL
PRIMARY_SITE_URL=http://localhost:8000

# Redis Configuration (optional)
REDIS_HOSTNAME=redis
REDIS_PORT=6379
REDIS_DEFAULT_DB=0
REDIS_CRAFT_DB=1