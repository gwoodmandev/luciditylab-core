{# templates/fields/heading-tag-field/_input.twig #}
<div class="heading-tag-field">
  {% for option in options %}
    <button type="button"
      class="btn {% if value == option %}active{% endif %}"
      data-value="{{ option }}"
    >
      {{ option|upper }}
    </button>
  {% endfor %}

  <input type="hidden"
    name="{{ field.handle }}"
    value="{{ value }}"
    id="hidden-{{ field.handle }}"
  >
</div>

<script>
  document.querySelectorAll('.heading-tag-field .btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.heading-tag-field');
      parent.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      parent.querySelector('input[type="hidden"]').value = btn.dataset.value;
    });
  });
</script>