{% set inputs = definitions|filter(d => d.isInput) %}

<div class="fb-detail">
    <h3 class="fb-detail__title">
        Submission &middot; {{ submission.dateCreated|datetime('long') }}
    </h3>
    <table class="data fullwidth">
        <tbody>
            {% for def in inputs %}
                {% set value = submission.payload[def.handle] ?? null %}
                <tr>
                    <th scope="row" style="width: 30%;">
                        {{ def.label ?: def.handle }}
                    </th>
                    <td>
                        {% if value is null or value == '' or (value is iterable and value|length == 0) %}
                            <span class="light">—</span>
                        {% elseif def.type == 'formFieldConsent' %}
                            {{ value ? 'Agreed' : 'Not agreed' }}
                        {% elseif def.type == 'formFieldFile' %}
                            <code>{{ value }}</code>
                            <span class="light">(stored in <code>storage/form-builder</code>)</span>
                        {% elseif value is iterable %}
                            {{ value|join(', ') }}
                        {% else %}
                            {{ value|nl2br }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            {% set known = inputs|map(d => d.handle) %}
            {% for handle, value in submission.payload|filter((value, handle) => handle not in known) %}
                <tr>
                    <th scope="row">
                        <code>{{ handle }}</code>
                        <span class="light">(removed field)</span>
                    </th>
                    <td>{{ value is iterable ? value|join(', ') : value }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="fb-detail__meta light" style="margin-top: 12px; font-size: 12px;">
        {% if submission.ipAddress %}IP: <code>{{ submission.ipAddress }}</code>{% endif %}
        {% if submission.userAgent %}
            <br>Browser: {{ submission.userAgent }}
        {% endif %}
    </div>
</div>
