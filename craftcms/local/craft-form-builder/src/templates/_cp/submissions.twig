<div
    class="fb-submissions"
    data-fb-submissions="{{ form.id }}"
    data-fb-badge="{{ unread }}"
    data-fb-badge-label="{{ badgeLabel }}"
>
    <div class="fb-submissions__toolbar">
        <div class="light">
            {% if total %}
                {{ total }} {{ total == 1 ? 'submission'|t('form-builder') : 'submissions'|t('form-builder') }}
                {%- if unread %}, <strong>{{ "{n} unread"|t('form-builder', { n: unread }) }}</strong>{% endif %}
            {% else %}
                {{ "No submissions yet"|t('form-builder') }}
            {% endif %}
        </div>

        {% if unread %}
            <button type="button" class="btn small" data-fb-mark-all>
                {{ "Mark all as read"|t('form-builder') }}
            </button>
        {% endif %}
    </div>

    {% if submissions|length %}

        <table class="data fullwidth fb-submissions__table">
            <thead>
                <tr>
                    <th scope="col" class="fb-col-thin"></th>
                    <th scope="col">{{ "Received"|t('form-builder') }}</th>
                    <th scope="col">{{ "Summary"|t('form-builder') }}</th>
                    <th scope="col" class="fb-col-thin"></th>
                </tr>
            </thead>
            <tbody>
                {% for submission in submissions %}
                    <tr
                        class="fb-submission{{ not submission.isRead ? ' fb-submission--unread' }}"
                        data-fb-submission="{{ submission.id }}"
                    >
                        <td>
                            <span
                                class="status {{ submission.isRead ? '' : 'enabled' }}"
                                title="{{ submission.isRead ? 'Read'|t('form-builder') : 'Unread'|t('form-builder') }}"
                            ></span>
                        </td>
                        <td>
                            <a href="#" role="button" data-fb-open>
                                {{ submission.dateCreated|datetime('short') }}
                            </a>
                        </td>
                        <td class="fb-submission__summary">{{ submission.summary }}</td>
                        <td class="thin">
                            <button
                                type="button"
                                class="btn small"
                                data-fb-toggle-read="{{ submission.isRead ? '1' : '0' }}"
                            >{{ submission.isRead ? 'Mark unread'|t('form-builder') : 'Mark read'|t('form-builder') }}</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if total > perPage %}
            <p class="light fb-submissions__note">
                {{ "Showing the {perPage} most recent of {total}."|t('form-builder', { perPage: perPage, total: total }) }}
            </p>
        {% endif %}

    {% else %}
        <p class="light">
            {{ "Submissions to this form will be listed here."|t('form-builder') }}
        </p>
    {% endif %}

    <div class="fb-submissions__detail" data-fb-detail hidden></div>
</div>
